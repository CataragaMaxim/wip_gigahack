# Copiază în .env.local pentru dezvoltare locală. Pe Vercel: Project → Settings → Environment Variables.

# Folosește o locație demonstrativă în Botanica în loc de GPS-ul real (util pentru demo: datele de test sunt în Chișinău).
VITE_USE_DEMO_LOCATION=false

# Stil hartă (CARTO, bazat pe OpenStreetMap). Verificați termenii de utilizare înainte de lansare publică.
VITE_TILES_LIGHT=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?key=cb1_3y9i_1_ad844f6d52cc4fc0274089cd
VITE_TILES_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=cb1_3y9i_1_ad844f6d52cc4fc0274089cd

# Firebase (neconectat încă — vezi src/services/README.md)
VITE_FIREBASE_API_KEY=AIzaSyAjDtXwA5HovA50qluO8yDaUj-hMUPj3YE
VITE_FIREBASE_AUTH_DOMAIN=work-in-progress-d4ff1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=work-in-progress-d4ff1
VITE_FIREBASE_STORAGE_BUCKET=work-in-progress-d4ff1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=954066642233
VITE_FIREBASE_APP_ID=1:954066642233:web:d3c8126a6c53de2d17f4e8
VITE_FIREBASE_MEASUREMENT_ID=G-8ERSSM932Y
# Doar local: folosește emulatorul Firestore (firebase emulators:start --only firestore) în loc de baza reală.
# VITE_FIRESTORE_EMULATOR=127.0.0.1:8085

# Telegram bot (setează local în telegram-bot/.env; nu copia tokenul în VITE_* sau în clientul web).
