rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function myType() {
      return get(/databases/$(database)/documents/users/$(uid())).data.userType;
    }
    function isAdmin() { return isSignedIn() && myType() >= 10000; }
    function isManager() { return isSignedIn() && myType() >= 1000; }

    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isManager());
      allow create: if isSignedIn() && uid() == userId;
      // Clientul poate schimba doar câmpuri "sigure" (nume, poză, locale, notificări).
      allow update: if isSignedIn() && (
        (uid() == userId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['userType', 'credibilityScore', 'banned', 'stats', 'createdAt'])
        ) || isAdmin()
      );
      allow delete: if isSignedIn() && uid() == userId;

      match /locations/{locId} {
        allow read, write: if isSignedIn() && uid() == userId;
      }

      match /history/{eventId} {
        allow read: if isSignedIn() && uid() == userId;
        allow create, update: if isSignedIn() && uid() == userId;
        allow delete: if false; // istoricul nu se șterge
      }
    }

    match /events/{eventId} {
      allow read: if true;
      // Reports start with zero votes. Admin SDK writes (scrapers and bot) bypass rules.
      allow create: if isSignedIn()
        && request.resource.data.authorId == uid()
        && request.resource.data.sourceType == 'citizen'
        && request.resource.data.confirmations == 0
        && request.resource.data.denials == 0;
      allow update: if isSignedIn()
        && (resource.data.authorId == uid() || isManager())
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['confirmations', 'denials']);
      allow delete: if isSignedIn() && resource.data.authorId == uid();

      match /votes/{voterId} {
        allow read: if isSignedIn() && (uid() == voterId || isManager());
        // Web votes go through the callable; Telegram uses the Admin SDK.
        allow create, update, delete: if false;
      }
    }
  }
}
