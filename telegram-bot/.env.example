# Copy this file to telegram-bot/.env for local bot development.
# Keep real tokens and service-account credentials out of Git and chat.
APP_FIREBASE_SERVICE_ACCOUNT=
# Set this explicitly to a development project (or your emulator project ID).
APP_FIREBASE_PROJECT_ID=
APP_FIREBASE_DATABASE_URL=
TELEGRAM_NOTIFICATION_POLL_SECONDS=30
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
APP_FIREBASE_AUTH_PAGE_URL=https://wip-deploy-test.vercel.app/telegram-auth
APP_FIREBASE_AUTH_ORIGIN=https://wip-deploy-test.vercel.app
